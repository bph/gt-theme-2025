l-900);display:flex;justify-content:flex-start;align-items:stretch;box-shadow:0 12px 32px rgba(0,0,0,0.35);} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-dialog{width:100%;background:transparent;color:#dbe7f5;padding:22px 0;display:flex;flex-direction:column;} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container-close{align-self:flex-end;width:44px;height:44px;margin:0 22px 18px;border:1px solid rgba(219,231,245,0.3);border-radius:0;color:#dbe7f5;} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container-close:hover,.wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container-close:focus-visible{border-color:var(--wp--preset--color--steel-500);background:rgba(89,128,166,0.28);} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__container{gap:0;align-items:stretch;} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation-item__content{display:flex;align-items:center;min-height:46px;box-sizing:border-box;padding:12px 22px;border-left:3px solid transparent;color:#dbe7f5;text-decoration:none;} .wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation-item__content:hover,.wp-block-navigation.gbt-drawer-nav .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation-item__content:focus-visible{background:rgba(89,128,166,0.28);border-left-color:var(--wp--preset--color--steel-500);color:#ffffff;text-decoration:none;}  @media (max-width: 600px){.gbt-subscribe{display:none !important;}}",
